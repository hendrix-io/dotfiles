# Ghostty configuration.
# Full option list: `ghostty +show-config --default --docs`
# Docs: https://ghostty.org/docs/config

theme = "ayu"

# Installed by sh/installs.sh (font-hack-nerd-font cask).
# The "Mono" variant keeps icon glyphs single-width so they don't shift columns.
# Ghostty embeds JetBrains Mono with Nerd Font fallback by default, so deleting
# this line falls back to that rather than to broken glyphs.
font-family = "Hack Nerd Font Mono"
font-size = 14

keybind = super+r=reload_config

# Lives in ~/.config/ghostty-shaders, which is not managed by this repo.
#custom-shader = ghostty-shaders/starfield.glsl
# custom-shader-animation = true
